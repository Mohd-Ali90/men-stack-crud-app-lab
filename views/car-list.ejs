<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Car list</title>
</head>
<body>
    <%-include('./partials/navbar')%>
    <h1>Car List</h1>
       <% if(cars.length === 0) {  %>
     <p> No cars available at the moment , we apologize for any inconvenience.</p>
     <a href="/cars/new">Use this link to create a new car listing</a>
 <% } %>

 <% for (let oneCar of cars){ %>
        <p>Name: <%= oneCar.name %></p>
        <a href="/cars/<%= oneCar._id  %>"> See Car Details</a>
     <% } %>
    
</body>
</html>